\abx@aux@cite{0}{Skog2010ZUPT}
\abx@aux@segm{0}{0}{Skog2010ZUPT}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Schematic of long-term JIT operation across hours/days. \textcolor {cb_green!75!black}{Green blocks} are active JIT sessions; \textcolor {cb_orange!85!black}{orange blocks} are short stationary intervals during which the device performs an opportunistic ZUPT recalibration. The \textcolor {cb_red!75!black}{red curve} is an illustrative envelope of the residual accelerometer bias that accumulates inside each session and is reset to within the noise floor at every ZUPT; under this design, the long-term envelope is bounded by the per-session bound rather than by an unbounded random walk.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:reb_zupt}{{6}{5}{Schematic of long-term JIT operation across hours/days. \textcolor {cb_green!75!black}{Green blocks} are active JIT sessions; \textcolor {cb_orange!85!black}{orange blocks} are short stationary intervals during which the device performs an opportunistic ZUPT recalibration. The \textcolor {cb_red!75!black}{red curve} is an illustrative envelope of the residual accelerometer bias that accumulates inside each session and is reset to within the noise floor at every ZUPT; under this design, the long-term envelope is bounded by the per-session bound rather than by an unbounded random walk}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Schematic (not to scale) of the Edge of Coverage (EoC) and JIT's trigger boundary. The EoC lies at $\pm \theta _{\text  {HPBW}}/2$ off boresight (\textcolor {cb_green!55!black}{green wedge edge}); the trigger boundary (\textcolor {cb_orange!85!black}{orange dashed edge}) sits inside the EoC, at the offset where the projected angular displacement over $T_{\text  {react}}$ reaches $\eta \,\theta _{\text  {HPBW}}$. The boundary is not a fixed-radius circle; it shifts toward boresight as $\|\dot  {\boldsymbol  {\delta }}\|$ grows.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:reb_eoc}{{7}{6}{Schematic (not to scale) of the Edge of Coverage (EoC) and JIT's trigger boundary. The EoC lies at $\pm \theta _{\text {HPBW}}/2$ off boresight (\textcolor {cb_green!55!black}{green wedge edge}); the trigger boundary (\textcolor {cb_orange!85!black}{orange dashed edge}) sits inside the EoC, at the offset where the projected angular displacement over $T_{\text {react}}$ reaches $\eta \,\theta _{\text {HPBW}}$. The boundary is not a fixed-radius circle; it shifts toward boresight as $\|\dot {\boldsymbol {\delta }}\|$ grows}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Mean capacity vs.\ JIT system reaction time $T_{\text  {react}}$ (log axis; illustrative; canonical scenario). The canonical $T_{\text  {react}} \approx 15\,\mu $s is set by the control-frame and AP-processing budgets and is not freely tunable; Hierarchical Search and IMU-Assist are essentially independent of $T_{\text  {react}}$.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:reb_treact}{{8}{9}{Mean capacity vs.\ JIT system reaction time $T_{\text {react}}$ (log axis; illustrative; canonical scenario). The canonical $T_{\text {react}} \approx 15\,\mu $s is set by the control-frame and AP-processing budgets and is not freely tunable; Hierarchical Search and IMU-Assist are essentially independent of $T_{\text {react}}$}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces System-model schematic (not to scale). The AP-anchored world frame ($X_W, Y_W, Z_W$) sits at the wall-mounted AP; the UE body frame ($\mathbf  {x}_b, \mathbf  {y}_b, \mathbf  {z}_b$) is carried by the UE via the orientation quaternion $\mathbf  {q}_{\text  {body}}$. The UE's translational velocity $\mathbf  {v}$ decomposes into the LoS-parallel component $\mathbf  {v}_{\parallel }$ and the LoS-perpendicular component $\mathbf  {v}_{\perp }$. Eq.~(6) sums $\boldsymbol  {\omega }_{\text  {UE}}$ and $\mathbf  {v}_{\perp }/d_{\text  {link}}$ with both terms transformed into the AP-anchored world frame via $\mathbf  {q}_{\text  {body}}$, giving a single 3D angular rate $\dot  {\boldsymbol  {\delta }}$.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:reb_sysmodel}{{9}{10}{System-model schematic (not to scale). The AP-anchored world frame ($X_W, Y_W, Z_W$) sits at the wall-mounted AP; the UE body frame ($\mathbf {x}_b, \mathbf {y}_b, \mathbf {z}_b$) is carried by the UE via the orientation quaternion $\mathbf {q}_{\text {body}}$. The UE's translational velocity $\mathbf {v}$ decomposes into the LoS-parallel component $\mathbf {v}_{\parallel }$ and the LoS-perpendicular component $\mathbf {v}_{\perp }$. Eq.~(6) sums $\boldsymbol {\omega }_{\text {UE}}$ and $\mathbf {v}_{\perp }/d_{\text {link}}$ with both terms transformed into the AP-anchored world frame via $\mathbf {q}_{\text {body}}$, giving a single 3D angular rate $\dot {\boldsymbol {\delta }}$}{figure.caption.10}{}}
