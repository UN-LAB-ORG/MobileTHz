\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Positioning of JIT against representative families of prior beam-management work. ``Pre / Post'' indicates whether the realignment is triggered before or after RF link degradation. ``Trigger'' is the signal source that initiates the realignment. ``Sub-THz HIL'' indicates whether the approach has been validated on sub-THz hardware-in-the-loop.}}{3}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:reb_relatedwork}{{1}{3}{Positioning of JIT against representative families of prior beam-management work. ``Pre / Post'' indicates whether the realignment is triggered before or after RF link degradation. ``Trigger'' is the signal source that initiates the realignment. ``Sub-THz HIL'' indicates whether the approach has been validated on sub-THz hardware-in-the-loop}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Hierarchical Search: mean capacity vs.\ spiral growth factor $\gamma $ (illustrative; canonical scenario). The peak lies near $\gamma = 1.25$ (Table~2). Smaller $\gamma $ refines the spiral too finely to converge within the beam-residence window; larger $\gamma $ jumps past the true alignment.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:reb_hsgamma}{{1}{3}{Hierarchical Search: mean capacity vs.\ spiral growth factor $\gamma $ (illustrative; canonical scenario). The peak lies near $\gamma = 1.25$ (Table~2). Smaller $\gamma $ refines the spiral too finely to converge within the beam-residence window; larger $\gamma $ jumps past the true alignment}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces IMU-Assist: mean capacity vs.\ refinement step factor $\beta $ (illustrative; canonical scenario). The peak lies near $\beta = 0.10$ (Table~2); smaller $\beta $ refines too slowly under mobility, larger $\beta $ causes the overshooting documented in \emph  {Methods}.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:reb_imubeta}{{2}{3}{IMU-Assist: mean capacity vs.\ refinement step factor $\beta $ (illustrative; canonical scenario). The peak lies near $\beta = 0.10$ (Table~2); smaller $\beta $ refines too slowly under mobility, larger $\beta $ causes the overshooting documented in \emph {Methods}}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces JIT: mean capacity vs.\ guard fraction $\eta $ (illustrative; canonical scenario). Mean capacity stays within $\pm 5\%$ of the maximum across $\eta \in [0.20, 0.50]$; the chosen $\eta = 0.36$ (Table~2) sits near the upper end of this plateau.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:reb_jiteta}{{3}{4}{JIT: mean capacity vs.\ guard fraction $\eta $ (illustrative; canonical scenario). Mean capacity stays within $\pm 5\%$ of the maximum across $\eta \in [0.20, 0.50]$; the chosen $\eta = 0.36$ (Table~2) sits near the upper end of this plateau}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces JIT: signaling overhead vs.\ guard fraction $\eta $ (illustrative; canonical scenario). Overhead decreases monotonically as $\eta $ grows; at the chosen $\eta = 0.36$ the overhead is $\approx 0.26\%$, consistent with Fig.~3c at $\SI {3}{m/s^2}$.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:reb_jitetaoverhead}{{4}{4}{JIT: signaling overhead vs.\ guard fraction $\eta $ (illustrative; canonical scenario). Overhead decreases monotonically as $\eta $ grows; at the chosen $\eta = 0.36$ the overhead is $\approx 0.26\%$, consistent with Fig.~3c at $\SI {3}{m/s^2}$}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mean capacity vs.\ IMU sampling period $T_{\text  {IMU}}$ (log axis; illustrative; canonical scenario). JIT is flat for $T_{\text  {IMU}} \leq 15$\,ms (commodity $\geq 1$\,kHz IMUs) and degrades gradually beyond; Hierarchical Search is independent of $T_{\text  {IMU}}$.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:reb_imuperiod}{{5}{4}{Mean capacity vs.\ IMU sampling period $T_{\text {IMU}}$ (log axis; illustrative; canonical scenario). JIT is flat for $T_{\text {IMU}} \leq 15$\,ms (commodity $\geq 1$\,kHz IMUs) and degrades gradually beyond; Hierarchical Search is independent of $T_{\text {IMU}}$}{figure.caption.5}{}}
